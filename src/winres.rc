#include "winresrc.h"
#include "../include/resource.h"
#include "../vs/config_package.h"

#define VERSION_NUMBER 2026,08,02,0

// Recursos de iconos
dosbox_ico ICON "../contrib/icons/CresnikDOS_Icon.ico"
IDI_CRESNIK_BAR ICON "../contrib/icons/CresnikDOS_BarraMenu.ico"
IDI_MAPPER ICON "../contrib/icons/mapper.ico"
IDI_CFG_GUI ICON "../contrib/icons/cfggui.ico"
IDI_PAUSE ICON "../contrib/icons/pause.ico"

// Recurso de información de versión
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_NUMBER
 PRODUCTVERSION VERSION_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Proyecto Cresnik DOS"
            VALUE "CompanyName", "Cresnik Collection"
            VALUE "FileDescription", "Emulador Cresnik DOS"
            VALUE "FileVersion", PACKAGE_VERSION
            VALUE "InternalName", "Cresnik DOS"
            VALUE "LegalCopyright", "Basado en DOSBox-X. Modificaciones Copyright 2026 Cresnik Collection. Distribuido bajo licencia GNU GPL."
            VALUE "OriginalFilename", "CresnikDOS.exe"
            VALUE "ProductName", "Cresnik DOS"
            VALUE "ProductVersion", PACKAGE_VERSION
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END